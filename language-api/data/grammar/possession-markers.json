{
  "version": 3,
  "description": "Местоименные формы: притяжание (-га), направление (-ахь), локация (-цига), движение (-цигахь), исход «от» (-гар/-ар)",
  "allative_possession": {
    "note": "У кого есть/нет: суга болх ба / суга болх бац",
    "markers": [
      { "ru": "у меня", "ing": "суга" },
      { "ru": "у тебя", "ing": "Хьуга" },
      { "ru": "у нас", "ing": "Вайга", "note": "мы + ты" },
      { "ru": "у него", "ing": "Цунга" },
      { "ru": "у неё", "ing": "Цунга" },
      { "ru": "у них", "ing": "Царга" }
    ]
  },
  "genitive_possessive": {
    "note": "Притяжательные: са=мой, тха=наш",
    "markers": [
      { "ru": "мой", "ing": "са" },
      { "ru": "наш", "ing": "тха" },
      { "ru": "твой", "ing": "хьа" }
    ]
  },
  "direction_allative_h": {
    "note": "Направление, сторона «к кому»: основа + ахь",
    "suffix": "ахь",
    "markers": [
      { "ru": "ко мне / к направлению меня", "ing": "Сугахь", "base": "суг" },
      { "ru": "к тебе", "ing": "Хьугахь", "base": "Хьуг" },
      { "ru": "к нам (я и ты)", "ing": "Вайгахь", "base": "Вайг" },
      { "ru": "к нам (без тебя)", "ing": "Тхугахь", "base": "Тхуг" },
      { "ru": "к нему / к ней", "ing": "Цунгахь", "base": "Цунг" },
      { "ru": "к ним", "ing": "Царгахь", "base": "Царг" }
    ]
  },
  "location_ciga": {
    "note": "Где находятся: -цига «у них там / у нас здесь»",
    "suffix": "цига",
    "markers": [
      { "ru": "у нас здесь (я и ты)", "ing": "Вайцига" },
      { "ru": "у нас здесь (без тебя)", "ing": "Тхацига" },
      { "ru": "у вас там", "ing": "Шунцига" },
      { "ru": "у них там", "ing": "Царцига" }
    ]
  },
  "motion_to_location_cigah": {
    "note": "Движение «к направлению где они/мы»: -цига + хь = -цигахь",
    "suffix": "цигахь",
    "rule": "цига + хь → цигахь",
    "markers": [
      {
        "ru": "к направлению к нам (родственнику, близкому)",
        "ing": "Вайцигахь",
        "register": "familiar"
      },
      {
        "ru": "к направлению к нам (не родственнику)",
        "ing": "Тхацигахь",
        "register": "formal"
      },
      { "ru": "к направлению к вам", "ing": "Шунцигахь" },
      { "ru": "к направлению к ним / к их месту", "ing": "Царцигахь" }
    ]
  },
  "ablative_from_r": {
    "note": "Исход «от кого/откуда»: к форме на -га или -цига добавляется -р → -гар / -цигар",
    "suffix": "р",
    "rule": "…га + р → …гар; …цига + р → …цигар",
    "from_possession_ga": [
      { "ru": "от меня", "ing": "Сугар", "from": "суга" },
      { "ru": "от тебя", "ing": "Хьугар", "from": "Хьуга" },
      { "ru": "от него", "ing": "Цунгар", "from": "Цунга" },
      { "ru": "от неё", "ing": "Цунгар", "from": "Цунга" },
      { "ru": "от нас", "ing": "Вайгар", "from": "Вайга" },
      { "ru": "от нас (без тебя)", "ing": "Тхугар", "from": "Тхуга" },
      { "ru": "от вас", "ing": "Шунгар", "from": "Шунга" },
      { "ru": "от них", "ing": "Царгар", "from": "Царга" }
    ],
    "from_location_ciga": [
      { "ru": "от нас (отсюда, мы с тобой)", "ing": "Вайцигар", "from": "Вайцига" },
      { "ru": "от нас (отсюда, без тебя)", "ing": "Тхацигар", "from": "Тхацига" },
      { "ru": "от вас (оттуда)", "ing": "Шунцигар", "from": "Шунцига" },
      { "ru": "от них (оттуда)", "ing": "Царцигар", "from": "Царцига" }
    ]
  },
  "existential": {
    "positive": "ба",
    "negative": "бац",
    "negative_rule": "вспомогательное + ц: ба→бац, да→дац"
  },
  "examples": [
    {
      "ru": "иди к нам",
      "ing": "Хьвале вайцига",
      "note": "обращение к близкому / родственнику"
    },
    {
      "ru": "иди к нам",
      "ing": "Хьвале тхацигахь",
      "note": "обращение к постороннему человеку"
    },
    {
      "ru": "у меня нет работы",
      "ing": "Суга болх бац"
    }
  ]
}
