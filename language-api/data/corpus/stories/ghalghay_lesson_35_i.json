{
  "id": "story_ghalghay_lesson_35_i_001",
  "title": "УРОК 35. ОТРИЦАТЕЛЬНЫЕ ПРЕДЛОЖЕНИЯ, МЕСТОИМЕНИЯ, ЧАСТИЦЫ (ДАЦАРА ПРЕДЛОЖЕНЕШ, ЦIЕРМЕТДЕШАШ, ДАКЪИЛГАШ)",
  "level": "A1",
  "genre": "lesson",
  "paragraphs": [
    {
      "ru": "Частица",
      "ing": "ЦА употребляется в причастно-деепричастных формах: ца вахача магац сона — не пойти я не могу"
    },
    {
      "ru": "С глаголами же частица",
      "ing": "ЦА употребляется как аффикс, т"
    },
    {
      "ru": "МА ГIОЛАХЬ ЦИГА",
      "ing": "НЕ ХОДИ ТУДА"
    },
    {
      "ru": "— А, ВАГIАЦ",
      "ing": "Нет, не иду"
    },
    {
      "ru": "СО КХИЙТАНЗАР",
      "ing": "Я не понял"
    },
    {
      "ru": "ХЬО КХИЙТАНЗАР",
      "ing": "Ты не понял"
    },
    {
      "ru": "ИЗ КХИЙТАНЗАР",
      "ing": "Он не понял"
    },
    {
      "ru": "ТХО КХИЙТАНЗАР",
      "ing": "Мы не поняли"
    },
    {
      "ru": "ШО КХИЙТАНЗАР",
      "ing": "Вы не поняли"
    },
    {
      "ru": "УЖ КХИЙТАНЗАР",
      "ing": "Они не поняли"
    },
    {
      "ru": "СО КХЕТАЦ",
      "ing": "Я не понимаю"
    },
    {
      "ru": "ХЬО КХЕТАЦ",
      "ing": "Ты не понимаешь"
    },
    {
      "ru": "ИЗ КХЕТАЦ",
      "ing": "Он не понимает"
    },
    {
      "ru": "ТХО КХЕТАЦ",
      "ing": "Мы не понимаем"
    },
    {
      "ru": "УЖ КХЕТАЦ",
      "ing": "Они не понимают"
    },
    {
      "ru": "ЖЕЛАЕМ УСПЕХА!",
      "ing": "АЬТТУВ ХИЛБА ШУН!"
    }
  ],
  "source": "https://ghalghay.com/2010/03/09/%d1%83%d1%80%d0%be%d0%ba-35-%d0%be%d1%82%d1%80%d0%b8%d1%86%d0%b0%d1%82%d0%b5%d0%bb%d1%8c%d0%bd%d1%8b%d0%b5-%d0%bf%d1%80%d0%b5%d0%b4%d0%bb%d0%be%d0%b6%d0%b5%d0%bd%d0%b8%d1%8f-%d0%bc%d0%b5%d1%81%d1%82/"
}
