  "paragraphs": [
    {
      "ru": "В ингушском языке имеются следующие типы наклонения: изъявительное, повелительное, желательное, отрицательное, вопросительное, вопросительно-отрицательное, условное.",
      "ing": "ГIалгIай мотта белгалдеш хьалхараш долаш ду: белгала, тIадожара, лара, дацара, хаттара, хаттара-дацара, бехкама соттам."
    },
    {
      "ru": "Девушка идет за водой.",
      "ing": "ЙОI ХИЙ ДА ЙОДА."
    },
    {
      "ru": "Девушка ходила за водой.",
      "ing": "ЙОI ХИЙ ДА ЯХАЯР."
    },
    {
      "ru": "Девушка пойдет за водой.",
      "ing": "ЙОI ХИЙ ДА ГIОРГЬЯ."
    },
    {
      "ru": "Говори быстрее. Надо говорить быстрее.",
      "ing": "СИХАГIА ДУВЦА. СИХАГIА ДУВЦА ДЕЗА."
    },
    {
      "ru": "Не теряй зря время.",
      "ing": "ЗЕХЬА ХА МА ЙОАЕЛАХЬ."
    },
    {
      "ru": "Я не был в Москве.",
      "ing": "СО МОСКВЕ ХИННАВАЦ."
    },
    {
      "ru": "Ты читал сегодняшнюю газету?",
      "ing": "ТАХАНАРА ГАЗЕТА ДИЙШАДИЙ IА?"
    },
    {
      "ru": "Ты завтра на свадьбу не идешь?",
      "ing": "ХЬО КХОАНА ХЬОАЛЧАГIА ВОДАЦИЙ?"
    },
    {
      "ru": "Ты был бы хорошим врачом.",
      "ing": "ДИКА ЛОР ХУРГВАР ХЬОХ."
    }
  ],
  "glossary": [
    { "ru": "изъявительное наклонение", "ing": "белгала соттам" },
