    },
    {
      "ru": "30 в ингушском — это 20 и 10.",
      "ing": "ТКЪАЬ ИТТ."
    },
    {
      "ru": "11, 12, 13, 14, 15, 16, 17, 18.",
      "ing": "ЦХЬАЙТТА, ШИЙТТА, КХОЙТТА, ДИЙТТА, ПХИЙТТА, ЯЛХАЙТТА, ВУРИЙТТА, БАРАЙТТА."
    },
    {
      "ru": "19 и 20.",
      "ing": "ТКЪЕСТА, ТКЪО."
    },
    {
      "ru": "21 это 20 и 1.",
      "ing": "ТКЪАЬ ЦАI."
    },
    {
      "ru": "40, 50, 60, 70, 80, 90.",
      "ing": "ШОВЗТКЪА, ШОВЗТКЪА ИТТ, КХОЗТКЪА, КХОВЗТКЪА ИТТ, ДЕЗТКЪА, ДЕЗТКЪА ИТТ."
    },
    {
      "ru": "100, 1000, миллион, миллиард.",
      "ing": "БIАЬ, ЭЗАР, МИЛЛИОН, МИЛЛИАРД."
    },
    {
      "ru": "Яха, сколько тебе лет?",
      "ing": "ЯХА, МЕЛ ХА ЯЬННАЙ ХЬА?"
    },
    {
      "ru": "Мне двадцать пять.",
      "ing": "СА ТКЪАЬ ПХИ ШУ ДАЬННАД."
    },
    {
      "ru": "Мне двадцать три.",
      "ing": "СА ТКЪАЬ КХО ШУ ДАЬННАД."
    },
    {
      "ru": "Слово «год» с любым числом произносится одинаково.",
      "ing": "ШУ ЛАРХIАРАШЦА ХЬАМАХ ДIАТIЕ ДА."
