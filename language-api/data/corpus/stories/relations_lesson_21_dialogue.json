{
  "id": "story_relations_lesson_21_001",
  "title": "Об отношениях между людьми (урок 21)",
  "level": "A1",
  "genre": "lesson",
  "paragraphs": [
    {
      "ru": "Ты меня любишь?",
      "ing": "ХЬОНА СО ЕЗИЙ (ВЕЗИЙ)?"
    },
    {
      "ru": "Я очень тебя люблю.",
      "ing": "СОНА ХЬО ЧIОАГIА ВЕЗА (ЕЗА)."
    },
    {
      "ru": "Я не люблю его.",
      "ing": "СОНА ВЕЗАЦ (ЕЗАЦ) ИЗ."
    },
    {
      "ru": "Ты мне нравишься.",
      "ing": "СОНА ХЬО ХОЗАХЕТ."
    },
    {
      "ru": "Я тебя уважаю.",
      "ing": "АЗ ХЬО ЛОАРХI."
    },
    {
      "ru": "Я ненавижу ложь.",
      "ing": "ХОАРЦО ЕЗАЦ СОНА."
    },
    {
      "ru": "Не забывайте нас.",
      "ing": "ТХО ДИЦ МА ДЕ."
    },
    {
      "ru": "У него большое горе.",
      "ing": "ЦУНГА БОККХА БАЛА БА."
    },
    {
      "ru": "Чем я могу вам помочь?",
      "ing": "СОГАРА ФУ ГIО-НОВКЪОСТАЛ ХУРГДА ХЬОНА?"
    },
    {
      "ru": "Мне страшно.",
      "ing": "СО КХЕР."
    },
    {
      "ru": "Давай помиримся.",
      "ing": "ТА ВАЙ ШИЪ."
    },
    {
      "ru": "Плохой мир лучше хорошей ссоры.",
      "ing": "ВО МАШАР ДИКАЧА ДОВНАЛ ТОЛ."
    }
  ],
  "glossary": [
    { "ru": "любовь", "ing": "безам" },
    { "ru": "уважение", "ing": "лоархIам" },
    { "ru": "ложь", "ing": "хоарцо" },
    { "ru": "горе", "ing": "бала" },
    { "ru": "помощь", "ing": "гIо-новкъостал" }
  ]
