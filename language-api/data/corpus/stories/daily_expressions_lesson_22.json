{
  "id": "story_daily_expressions_lesson_22_001",
  "title": "Повседневные слова и выражения (урок 22)",
  "level": "A1",
  "genre": "lesson",
  "paragraphs": [
    {
      "ru": "Вы свободны?",
      "ing": "ХЬО МУКЪА ВИЙ (ЙИЙ)?"
    },
    {
      "ru": "Я свободен (свободна).",
      "ing": "СО МУКЪА ВА (Я)."
    },
    {
      "ru": "У меня к вам разговор.",
      "ing": "ХЬОЦА КЪАМАЬЛ ДАР СА."
    },
    {
      "ru": "Мне бы хотелось с Вами поговорить.",
      "ing": "ХЬОЦА КЪАМАЬЛ ДУВЦА БЕЗАМ БАР СА."
    },
    {
      "ru": "Когда мы могли бы с Вами встретиться?",
      "ing": "МАЦА ВIАШАГIКХЕТА ВIАШТIЕХЬДАРГДА ВАЙ?"
    },
    {
      "ru": "Постарайся не опаздывать!",
      "ing": "ТIЕХЬА ЦА ВИСА ХЬАЖАЛАХЬ!"
    },
    {
      "ru": "Я Вас не понял.",
      "ing": "СО ХЬОХ КХИЙТАНЗАР."
    },
    {
      "ru": "Пожалуйста, говорите медленнее.",
      "ing": "КIЕЗИГА ШОРТАГIА ДУВЦАЛ."
    },
    {
      "ru": "Я самостоятельно изучаю ингушский язык.",
      "ing": "АЗ АЙСА IОМАБУ ГIАЛГIАЙ МОТТ."
    },
    {
      "ru": "Что означает это слово?",
      "ing": "ЦУ ДЕША ФУ МАIАН ДА?"
    },
    {
      "ru": "Где Вы изучаете ингушский язык?",
      "ing": "ГIАЛГIАЙ МОТТ МИЧАХЬА IОМАБУ IА?"
    },
    {
      "ru": "Не знаю — одно слово, узнал — тысяча слов.",
      "ing": "ХАЦ, ДАЦ — ЦХЬА ДОШ, ХАИРА, ДАЙРА ЭЗАР ДОШ."
    }
  ],
  "glossary": [
    { "ru": "свободный", "ing": "мукъа" },
