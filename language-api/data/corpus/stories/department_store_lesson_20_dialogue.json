{
  "id": "story_department_store_lesson_20_001",
  "title": "Посещение универмага (урок 20)",
  "level": "A1",
  "genre": "dialogue",
  "paragraphs": [
    {
      "ru": "Обувь.",
      "ing": "КОГАГIИРС (МАЬЧЕШ)."
    },
    {
      "ru": "Парфюмерия.",
      "ing": "ПАРФЮМЕРИ."
    },
    {
      "ru": "Одежда.",
      "ing": "БАРЗКЪА."
    },
    {
      "ru": "Игрушки.",
      "ing": "ЛОВЗОРГАШ."
    },
    {
      "ru": "Подарки.",
      "ing": "СОВГIАТАШ."
    },
    {
      "ru": "Покажите мне, пожалуйста, этот костюм.",
      "ing": "ХЬАХЬОКХАЛ СОГА ИЗ КОСТЮМ (КОЧ, ЮБКА, ХАЧИ)."
    },
    {
      "ru": "Можно ли его примерить?",
      "ing": "ТIАЙИЙХА ХЬАЖА МЕГАРГДАРИЙ ЦУНГА?"
    },
    {
      "ru": "Где находится примерочная?",
      "ing": "БАРЗКЪА ТIАДУВХА МЕТТИГ МИЧАХЬА Я ШУН?"
    },
    {
      "ru": "Какого размера это платье?",
      "ing": "УКХ КОЧА РАЗМЕР МАЛАГIА Я?"
    },
    {
      "ru": "Есть ли у вас куртки другого цвета?",
      "ing": "КХЫ БОС БОЛА КУРТКАШ ЙИЙ ШУГА?"
    },
    {
      "ru": "Вы сделали очень хороший выбор.",
      "ing": "IА ЧIОАГIА ДИКА ХIАМАШ ХЕРЖАЙ."
    },
    {
      "ru": "Я их покупаю. Они мне очень идут.",
      "ing": "АЗ ХЬАЭЦ ЕРАШ. СОГА ЧIОАГIА ХОЗА ТОВ УЖ."
    },
    {
      "ru": "Приходите к нам чаще.",
      "ing": "ДУВЛА ТХО ДОЛЧА КАСТ-КАСТА."
    },
    {
      "ru": "Чаще дарите своим близким подарки!",
      "ing": "КАСТ-КАСТА ТЕЛА ШОАЙ ГАРГАРЧА НАХА СОВГIАТАШ!"
    }
  ],
