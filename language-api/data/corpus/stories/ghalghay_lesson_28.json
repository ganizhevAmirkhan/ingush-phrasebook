{
  "id": "story_ghalghay_lesson_28_001",
  "title": "УРОК 28. НАКЛОНЕНИЕ ГЛАГОЛА (ХАНДЕШАЙ СОТТАМ)",
  "level": "A1",
  "genre": "dialogue",
  "paragraphs": [
    {
      "ru": "Девушка идет за водой",
      "ing": "ЙОI ХИЙ ДА ЙОДА"
    },
    {
      "ru": "Фатима читает книгу",
      "ing": "ФАТИМАС КНИЖКА ДЕШ"
    },
    {
      "ru": "Девушка ходила за водой",
      "ing": "ЙОI ХИЙ ДА ЯХАЯР"
    },
    {
      "ru": "Фатима читала книгу",
      "ing": "ФАТИМАС КНИЖКА ДИЙШАДАР"
    },
    {
      "ru": "Девушка пойдет за водой",
      "ing": "ЙОI ХИЙ ДА ГIОРГЬЯ"
    },
    {
      "ru": "Фатима прочитает книгу",
      "ing": "ФАТИМАС КНИЖКА ДЕШАРГДА"
    },
    {
      "ru": "а) Говори быстрее.",
      "ing": "СИХАГIА ДУВЦА."
    },
    {
      "ru": "б) Надо говорить быстрее.",
      "ing": "СИХАГIА ДУВЦА ДЕЗА."
    },
    {
      "ru": "Выпей чай.",
      "ing": "ЧАЙ МАЛАЛ"
    },
    {
      "ru": "Скажи мне что-нибудь.",
      "ing": "ЦХЬА ХIАМА АЛАЛ СОГА."
    },
    {
      "ru": "Не теряй зря время.",
      "ing": "ЗЕХЬА ХА МА ЙОАЕЛАХЬ."
    },
    {
      "ru": "Не теряйте зря время.",
      "ing": "ЗЕХЬА ХА МА ЙОАЕЛАШ."
    },
    {
      "ru": "Учись, не пожалеешь.",
      "ing": "ДЕШАЛАХЬ, ДЕХКЕВАРГВАЦ ХЬО."
    },
    {
      "ru": "Учитесь, не пожалеете.",
      "ing": "ДЕШАЛАШ, ДЕХКЕДОВРГДАЦ ШО."
    },
    {
      "ru": "Пойди к врачам, выздоровеешь.",
      "ing": "ГIОЛ ХЬАЙ ЛОРАШ БОЛЧА, ВЕРЗАРГВА ХЬО."
    },
    {
      "ru": "Пойдите к врачам, выздоровеете.",
      "ing": "ГIОЛ ШОАЙ ЛОРАШ БОЛЧА, ДЕРЗАРГДА ШО."
    },
    {
      "ru": "Как душно, пошел бы сегодня дождь.",
      "ing": "МА IИМЕРЦА Я ВАЙНА, ДОГIА ДЕЛХАДАЛАРА ТАХАН."
    },
    {
      "ru": "Писала бы я, а не сидела.",
      "ing": "ЯЗДАЬДАЛАРА АЗ, IОХАЙНА ЦА ЯГIАШ."
    },
    {
      "ru": "Выздоровел бы отец .",
      "ing": "ВЕРЗАРГВАЛАР СА ДА"
    },
    {
      "ru": "Я не был в Москве.",
      "ing": "СО МОСКВЕ ХИННАВАЦ."
    },
    {
      "ru": "Я не буду тебя ждать.",
      "ing": "СО ХЬОГА ХЬЕЖАРГВАЦ."
    },
    {
      "ru": "Ты читал сегодняшнюю газету?",
      "ing": "ТАХАНАРА ГАЗЕТА ДИЙШАДИЙ IА?"
    },
    {
      "ru": "Ты ходил вчера в университет.",
      "ing": "СЕЛХАН УНИВЕРСИТЕТЕ ВАХАРИЙ ХЬО?"
    },
    {
      "ru": "Ты завтра на свадьбу не идешь?",
      "ing": "ХЬО КХОАНА ХЬОАЛЧАГIА ВОДАЦИЙ?"
    },
    {
      "ru": "Ты не читал статью?",
      "ing": "IА СТАТЬЯ ЙИЙШАЕЦИЙ?"
    },
    {
      "ru": "Я бы жил в Тарском",
      "ing": "АНГУШТА ВАХАРГВАР СО."
    },
    {
      "ru": "Ты был бы хорошим врачом.",
      "ing": "ДИКА ЛОР ХУРГВАР ХЬОХ."
    },
    {
      "ru": "Пусть тебя полюбит каждый, кто любит воду.",
      "ing": "ХИЙ МЕЛ ДЕЗАЧУННА ВЕЗАЛВА ХЬО (пожелание — ловца)"
    }
  ],
