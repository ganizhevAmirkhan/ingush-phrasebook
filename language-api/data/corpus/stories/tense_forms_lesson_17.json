{
  "id": "story_tense_forms_lesson_17_001",
  "title": "Формы времени (урок 17)",
  "level": "A2",
  "genre": "lesson",
  "paragraphs": [
    {
      "ru": "В ингушском языке семь форм времени.",
      "ing": "ГIАЛГIАЙ МОТТА ШОА ФОРМА ХА Я."
    },
    {
      "ru": "Настоящее время.",
      "ing": "ЙОЛА ХА."
    },
    {
      "ru": "Мадина идет в школу.",
      "ing": "МАДИНА ШКОЛЕ ЙОДА."
    },
    {
      "ru": "Снег идет.",
      "ing": "ЛОА ДЕЛХ."
    },
    {
      "ru": "Прошедшее (несовершенное очевидное).",
      "ing": "ГУШ ЯХА ЯЛАНЗА ХА."
    },
    {
      "ru": "Алихан разговаривал.",
      "ing": "АЛИХАНА КЪАМАЬЛ ДУВЦАР."
    },
    {
      "ru": "Прошедшее (совершенное неочевидное).",
      "ing": "ЯХА ХА."
    },
    {
      "ru": "Муса написал стихотворение.",
      "ing": "МУСАС СТИХОТВОРЕНИ ЯЗЪЯЬЙ."
    },
    {
      "ru": "Прошедшее совершенное очевидное время.",
      "ing": "ГУШ ЯХА ХА."
    },
    {
      "ru": "Повар пожарил рыбу.",
      "ing": "ПОВАРО ЧКЪАЬРА КХЕРЗАР."
    },
    {
      "ru": "Давнопрошедшее время.",
      "ing": "ХЬАЛХА ЯХА ХА."
    },
    {
      "ru": "Саид ходил в гости к своим родственникам.",
      "ing": "САИД ШИЙ ГАРГАРА НАХ БОЛЧА ВАХАВАР."
    },
    {
      "ru": "Будущее возможное.",
      "ing": "ХИЛА МЕГА ХА."
    },
    {
      "ru": "Будущее время.",
      "ing": "ХУРГЙОЛА ХА."
    },
    {
      "ru": "Я завтра пойду к Мадине.",
      "ing": "СО КХОАНА МАДИНА ЙОЛЧА ГIОРГЬЯ."
    },
    {
      "ru": "Пусть к вам придет все хорошее.",
      "ing": "ДИКА МЕЛ ДАР ДОАГIАЛДА ШУГА."
    }
  ],
  "glossary": [
    { "ru": "настоящее время", "ing": "йола ха" },
    { "ru": "прошедшее время", "ing": "яха ха" },
    { "ru": "будущее время", "ing": "хургйола ха" },
    { "ru": "давнопрошедшее", "ing": "хьалха яха ха" },
