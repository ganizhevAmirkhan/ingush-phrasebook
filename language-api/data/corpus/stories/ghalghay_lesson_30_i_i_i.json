{
  "id": "story_ghalghay_lesson_30_i_i_i_001",
  "title": "УРОК 30. ВСТРЕЧА ДРУЗЕЙ (ДОТТАГIИЙ ВIАШАГIКХЕТАР)",
  "level": "A1",
  "genre": "dialogue",
  "paragraphs": [
    {
      "ru": "Здравствуй, Саид!",
      "ing": "IУЙРЕ ДИКА ХИЙЛА ХЬА, САIИД!"
    },
    {
      "ru": "Как ты отдохнул?",
      "ing": "СА МИШТА ЛЕIАД IА?"
    },
    {
      "ru": "Выглядишь очень хорошо.",
      "ing": "БОС-М ВО БАЦ ХЬА."
    },
    {
      "ru": "Куда — нибудь ездил?",
      "ing": "ЦХЬАННАХЬА ДIА-ХЬА ВАХА ХИННАВИЙ ХЬО?"
    },
    {
      "ru": "Ваха, здравствуй!",
      "ing": "ДИКАНЦА ВАХИЙЛА, ВАХА!"
    },
    {
      "ru": "Рад нашей встрече!",
      "ing": "ДИКА ХЕТ ХЬО БIАРГАВАЙНА."
    },
    {
      "ru": "Отдохнул я очень хорошо.",
      "ing": "ДИКА САЛЕIАД АЗ."
    },
    {
      "ru": "Об отдыхе можно говорить очень много.",
      "ing": "САЛОIАМАХ ЛАЬЦА ДУКХА ДУВЦА ЙИШ Я."
    },
    {
      "ru": "Я принесу тебе фотографии, и ты сможешь увидеть своими глазами, где я побывал.",
      "ing": "АЗ СУРТАШ ДАХЬАРГДА ХЬОНА, ТIАКККХА ХЬАЙНА БIАРГЛУРГДА ХЬОНА, СО МИЧАХЬА ХИННАВ."
    },
    {
      "ru": "Время даром не терял, видимо, ты хорошо отдохнул. Да, мне хочется посмотреть фотографии.",
      "ing": "ХЬО ЗЕХЬА ХА ЙОАЕШ ХИННАВАЦ. ХЕТАРГАХЬА, IА ДИКА САЛЕIАД. ХIАА, СУРТАШКА ХЬАЖА БЕЗАМ БА СА."
    },
    {
      "ru": "А ты где отдыхал?",
      "ing": "ТIАККХА ХЬО МИЧАХЬА ХИННАВ САЛОIАШ?"
    },
    {
      "ru": "Видно, что на море.",
      "ing": "ФОРДА ЙИСТЕ ХИННАЛГА ГУШ ДА."
    },
    {
      "ru": "После отдыха чувствуешь прилив новых сил и, я думаю.",
      "ing": "САЛЕIАЧА КЕРДА НИЗ ЧУБОС ДЕГIА."
    },
    {
      "ru": "Я полностью с тобой согласен.",
      "ing": "СО IА ДУВЦАЧУННА РАЬЗА ВА."
    },
    {
      "ru": "ЖЕЛАЕМ УСПЕХА!",
      "ing": "АЬТТУВ ХИЛБА ШУН!"
    }
  ],
  "source": "https://ghalghay.com/2010/02/20/%d1%83%d1%80%d0%be%d0%ba-30-%d0%b2%d1%81%d1%82%d1%80%d0%b5%d1%87%d0%b0-%d0%b4%d1%80%d1%83%d0%b7%d0%b5%d0%b9-%d0%b4%d0%be%d1%82%d1%82%d0%b0%d0%b3i%d0%b8%d0%b9-%d0%b2i%d0%b0%d1%88%d0%b0%d0%b3i%d0%ba/"
}
