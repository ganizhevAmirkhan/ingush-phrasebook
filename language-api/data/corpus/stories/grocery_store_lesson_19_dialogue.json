{
  "id": "story_grocery_store_lesson_19_001",
  "title": "Посещение продовольственного магазина (урок 19)",
  "level": "A1",
  "genre": "dialogue",
  "paragraphs": [
    {
      "ru": "В этом году в Назрани открылся продовольственный магазин.",
      "ing": "УКХ ШЕРА НАЗРАНЕ КЕРДА КХАЧАН ТИКА ХЬАЙИЙЛАЙ."
    },
    {
      "ru": "Мясной отдел.",
      "ing": "ДУЛХ ДОХКА ОТДЕЛ."
    },
    {
      "ru": "Рыбный отдел.",
      "ing": "ЧКЪАЬРИЙ ДОХКА ОТДЕЛ."
    },
    {
      "ru": "Отдел молочных продуктов.",
      "ing": "ШУРАХ ЯЬ ПРОДУКТАШ ЙОХКА ОТДЕЛ."
    },
    {
      "ru": "Покажите мне этот кусок мяса.",
      "ing": "ИЗ БЕЖАН ДУЛХА ДАКЪА ХЬОКХАЛ СОГА."
    },
    {
      "ru": "А баранина у вас есть?",
      "ing": "УСТАГIАН ДУЛХ ДИЙ ШУГА?"
    },
    {
      "ru": "Взвесьте мне 1 кг баранины и 2 кг нежирной говядины.",
      "ing": "ЦХЬА КИЙЛА УСТАГIАН ДУЛХИ 2 КИЙЛА ДЕРСТА ДОАЦАРА БЕЖАНА ДУЛХИ ОЗАЛ СОНА."
    },
    {
      "ru": "Выберите мне вкусный торт без спиртного.",
      "ing": "ЧХЬАГIАР ТЕХА ЙОАЦАШ ЧАМ БОЛАШ ТОРТ ХАРЖАЛ СОНА."
    },
    {
      "ru": "Пробейте мне, пожалуйста, чек.",
      "ing": "ЧЕК ЯККХАЛ СОНА."
    },
    {
      "ru": "Сколько я должна заплатить?",
      "ing": "ФУ ДАЛА ДЕЗА АЗ?"
    },
    {
      "ru": "Вам что-нибудь еще нужно?",
      "ing": "КХЫ ХIАМА ЕЗИЙ ХЬОНА?"
    },
    {
      "ru": "Я думаю, этого достаточно.",
      "ing": "АЗ ИЙЦАР ТОЪАРГЙОЛАШ САННА ХЕТ СОНА."
    },
    {
      "ru": "Там можно поторговаться.",
      "ing": "ЦИГА МАХ БУВЦА ЙИШ Я."
    },
    {
      "ru": "Спасибо за покупки!",
      "ing": "БАРКАЛ ХIАМАШ ЭЦАРАХ!"
    }
  ],
  "glossary": [
    { "ru": "хлеб", "ing": "маькх" },
    { "ru": "мука", "ing": "хьоар" },
    { "ru": "сахар", "ing": "шекар" },
