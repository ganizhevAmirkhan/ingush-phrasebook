    {
      "ru": "В ингушском языке восемь падежей.",
      "ing": "ГIалгIай мотта ворхIан падеж йисте хинна."
    },
    {
      "ru": "Дождь идет.",
      "ing": "ДОГIА ДЕЛХ."
    },
    {
      "ru": "Ученик читает книгу.",
      "ing": "ДЕШАРХОЧО КНИЖКА ДЕШ."
    },
    {
      "ru": "Я с братом поехала в горы.",
      "ing": "СО ВЕШИЙЦА ЛОАМ ЯХАЙ."
    },
    {
      "ru": "Я боюсь брата.",
      "ing": "ВЕШЕХ ВАХЬАЦ СО."
    },
    {
      "ru": "Лучше моей матери никого нет.",
      "ing": "СА НАЬНАЛ ДИКАГIА САГ ВАЦ."
    },
    {
      "ru": "Дом-дома; сосед-соседи; цветок-цветы.",
      "ing": "ЦIа-цIенош; лоалахо-лоалахой; зиза-зизаш."
    }
  ],
