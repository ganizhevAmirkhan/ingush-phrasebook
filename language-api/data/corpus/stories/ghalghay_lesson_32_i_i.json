{
  "id": "story_ghalghay_lesson_32_i_i_001",
  "title": "УРОК 32. ПРЕДЛОЖЕНИЕ В ИНГУШСКОМ ЯЗЫКЕ (ГIАЛГIАЙ МЕТТА ПРЕДЛОЖЕНИ)",
  "level": "A1",
  "genre": "lesson",
  "paragraphs": [
    {
      "ru": "Они остановили телегу",
      "ing": "ЦАР ВОРДА СОЦАЙИР"
    },
    {
      "ru": "Мальчик идет в школу",
      "ing": "КIАЬНК ШКОЛЕ ВОДА"
    },
    {
      "ru": "Мальчик пошел в школу",
      "ing": "КIАЬНК ШКОЛЕ ВАХАВ"
    },
    {
      "ru": "Мальчик пойдет в школу",
      "ing": "КIАЬНК ШКОЛЕ ГIОРГВА"
    },
    {
      "ru": "СО КИНО ВОДА",
      "ing": "Я иду в кино"
    },
    {
      "ru": "Мальчик видит горы",
      "ing": "КIАЬНКА ЛОМАШ ГУ."
    },
    {
      "ru": "Составное сказуемое выражается инфинитивом (неопределенной формой) и глаголом вспомогательного значения: НУЖНО СКАЗАТЬ",
      "ing": "АЛА ДЕЗА."
    },
    {
      "ru": "Алихан писал",
      "ing": "АЛИХАН ЯЗДЕШ ВАР"
    },
    {
      "ru": "Алихан пишет",
      "ing": "АЛИХАН ЯЗДЕШ ВОАЛЛ"
    },
    {
      "ru": "Алихан будет писать",
      "ing": "АЛИХАН ЯЗДЕШ ХУРГВА"
    },
    {
      "ru": "ЖЕЛАЕМ УСПЕХА!",
      "ing": "АЬТТУВ ХИЛБА ШУН!"
    }
  ],
