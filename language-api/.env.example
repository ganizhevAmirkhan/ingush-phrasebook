PORT=8787
ADMIN_SECRET=change_me

# Фразы из categories/*.json (Habar) в /translate (true = выключить)
DISABLE_HABAR_IN_TRANSLATE=false

# Порядок LLM fallback (можно менять в админке → шестерёнка)
LLM_ORDER=gigachat,openrouter,gemini

# GigaChat (ключ авторизации из кабинета Sber; Base64)
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat
GIGACHAT_BASE_URL=https://gigachat.devices.sberbank.ru/api/v1
GIGACHAT_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_TLS_INSECURE=true

# OpenRouter — бесплатно, без баланса (роутер сам выберет свободную модель):
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=openrouter/free
OPENROUTER_FREE_ONLY=true
OPENROUTER_SITE_URL=https://api.inghub.ru
OPENROUTER_APP_NAME=Ingush LanguageAPI

GEMINI_API_KEY=
LLM_GEMINI_FALLBACK=false
