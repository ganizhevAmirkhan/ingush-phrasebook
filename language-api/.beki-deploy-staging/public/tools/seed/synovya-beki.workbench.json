    {
      "id": "beki_004",
      "status": "verified",
      "ru": "И Сагопши тогда, если посмотреть на долину с гор, кажется завернутым в вату.",
      "ing": "ТӀаккха дехьарча а сехьарча а дукъ тӀара чухьежача, боамбе юкъе хьоарчаяь дӀахьулайича санна  хеталу СоагӀапче.",
      "phrases": [
        {
          "ru": "с той с другой",
          "ing": "дехьарча а сехьарча а"
        },
        {
          "ru": "с хребта посмотреть",
          "ing": "дукъ тӀара чухьежача"
        },
        {
          "ru": "среди ваты завёрнутый",
          "ing": "боамбе юкъе хьоарчаяь дӀахьулайича"
        },
        {
          "ru": "кажется",
          "ing": "санна  хеталу"
        }
      ],
