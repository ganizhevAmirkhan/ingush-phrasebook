    {
      "id": "beki_005",
      "status": "verified",
      "ru": "Было время уборки кукурузы. Многие сельчане успели уже управиться с делами, другие только кончали уборку, а Беки еще и не принимался за свою десятину, что посеял на земле Мазаева.",
      "ing": "ХьажкӀаш чуэцаш латта ха яр из. Вешта юртахой дукхагӀбараш-м чуийца баьнна а бовла боахкаш а бар, Беки вар-кх тӀехьависар. Помещика Мазаева лаьтта дӀайийна хьажкӀий дистан яр цун.",
      "phrases": [
        {
          "ru": "был из опоздавших",
          "ing": "вар-кх тӀехьависар"
        },
        {
          "ru": "уборка кукурузы",
          "ing": "ХьажкӀаш чуэцаш латта"
        },
        {
          "ru": "десетина кукурузы",
          "ing": "хьажкӀий дистан"
        }
      ],
      "words": [
        {
          "ru": "большенство",
          "ing": "дукхагӀбараш",
          "pos": "",
          "note": ""
        }
      ],
      "notes": ""
    },
    {
      "id": "beki_006",
      "status": "verified",
      "ru": "Раньше Беки сеял кукурузу в Витэ-балке или на месте бывшего села Цокалой-Юрт.",
      "ing": "ХӀанзалца Вите берчу е Цокалой-Юрт иллача юврта Беке хьажкӀаш.",
      "phrases": [],
      "words": [],
      "notes": ""
