{
  "category": "misc",
  "items": [
    {
      "ru": "Пожалуйста",
      "Ing": "Хьуна халд",
      "pron": "hyuna hald",
      "id": "f_1766024853692_c25j",
      "audio": "f_1766024853692_c25j.mp3",
      "ing": "боккъала"
    },
    {
      "ru": "Спасибо",
      "ing": "Баркалла",
      "pron": "barkalla",
      "id": "f_1766024853692_uk8q",
      "audio": "f_1766024853692_uk8q.mp3"
    },
    {
      "ru": "Извини",
      "ing": "Къат1ер валл",
      "pron": "qat1er vall",
      "id": "f_1766024853692_x7a1",
      "audio": "f_1766024853692_x7a1.mp3"
    },
    {
      "ru": "Я не знаю",
      "ing": "Сун хац",
      "pron": "sun khats",
      "id": "f_1766024853692_sfk0",
      "audio": "f_1766024853692_sfk0.mp3"
    },
    {
      "ru": "Я думаю",
      "ing": "Сун хет",
      "pron": "sun khet",
      "id": "f_1766024853692_47e6",
      "audio": "f_1766024853692_47e6.mp3"
    },
    {
      "ru": "Я дома",
      "ing": "Со ц1ага ва",
      "pron": "so ts1aga va",
      "id": "f_1766024853692_becb",
      "audio": "f_1766024853692_becb.mp3"
    },
    {
      "ru": "Я хочу домой",
      "ing": "Ц1а вах безам ба са",
      "pron": "ts1a vakh bezam ba sa",
      "id": "f_1766024853692_it30",
      "audio": "f_1766024853692_it30.mp3"
    },
    {
      "ru": "Мне нужно идти",
      "ing": "Са давах вез",
      "pron": "sa davakh vez",
      "id": "f_1766024853692_t6wu",
      "audio": "f_1766024853692_t6wu.mp3"
    },
    {
      "ru": "Мне надо идти",
      "ing": "Са веза даваха",
      "pron": "sa veza davakha",
      "id": "f_1766024853692_nado_idti",
      "audio": "f_1766024853692_nado_idti.mp3"
    },
    {
      "ru": "Я приду позже",
      "ing": "Со т1ехьа хьа воаг1агва",
      "pron": "so t1ekhya kha voag1agva",
      "id": "f_1766024853692_af8t",
      "audio": "f_1766024853692_af8t.mp3"
    },
    {
      "ru": "Дай сюда",
      "ing": "Хьокха хий",
      "pron": "khyokha hiy",
      "id": "f_1766024853692_hq4y",
      "audio": "f_1766024853692_hq4y.mp3"
    },
    {
      "ru": "Отойди",
      "ing": "Яккха",
      "pron": "yakkha",
      "id": "f_1766024853692_avpl",
      "audio": "f_1766024853692_avpl.mp3"
    },
    {
      "ru": "Мне нравится",
      "ing": "Сун хозхет",
      "pron": "sun khozkhet",
      "id": "f_1766024853692_atvt",
      "audio": "f_1766024853692_atvt.mp3"
    },
    {
      "ru": "Мне не нравится",
      "ing": "Сун хозхетац",
      "pron": "sun khozkhetats",
      "id": "f_1766024853692_s9en",
      "audio": "f_1766024853692_s9en.mp3"
    },
    {
      "id": "f_1766024853692_uenr",
      "ru": "Я большой человек",
      "ing": "Со воккха саг ва",
      "pron": "so vokkha sag va",
      "audio": "f_1766024853692_uenr.mp3"
    },
    {
      "ru": "Да будет принято ваше жертвоприношение!",
      "ing": "ГӀурба къоабала хилда шун",
      "pron": "gӏurba kъoabala khilda shun",
      "id": "paydadosh_pd_682",
      "audio": "paydadosh_pd_682.mp3"
    },
    {
      "ru": "Да не отлучит тебя Аллах от того, кто мил твоему глазу и люб твоему сердцу",
      "ing": "Хьай б1арга хоза а хеташ, дега дукха а везаш волча сагах ма воаккхалва хьо Дала",
      "pron": "khьay b1arga khoza a khetash, dega dukkha a vezash volcha sagakh ma voakkkhalva khьo dala",
      "id": "paydadosh_pd_1288",
      "audio": "paydadosh_pd_1288.mp3"
    },
    {
      "ru": "Да́ла иман сабр лулда шоана!",
      "ing": "Пусть Всевышний дарует вам веру и терпение!",
      "pron": "pustь vsevyshniy daruet vam veru i terpenie!",
      "id": "paydadosh_pd_669",
      "audio": "paydadosh_pd_669.mp3"
    },
    {
      "ru": "Заимствованное из арабского универсальное приветствие («мир вам»)",
      "ing": "Ассалам Ӏалайкум",
      "pron": "assalam ӏalaykum",
      "id": "paydadosh_pd_19929",
      "audio": "paydadosh_pd_19929.mp3"
    },
    {
      "ru": "Короткое пожелание здоровья женщине при чихании (буквально: «живи»)",
      "ing": "Яхийла!",
      "pron": "yakhiyla!",
      "id": "paydadosh_pd_19962",
      "audio": "paydadosh_pd_19962.mp3"
    },
    {
      "ru": "Короткое пожелание здоровья мужчине при чихании (буквально: «живи»)",
      "ing": "Вахалва!",
      "pron": "vakhalva!",
      "id": "paydadosh_pd_19961",
      "audio": "paydadosh_pd_19961.mp3"
    },
    {
      "ru": "Оберегать гостя",
      "ing": "хьаьша лоравар",
      "pron": "khьaьsha loravar",
      "id": "paydadosh_pd_1280",
      "audio": "paydadosh_pd_1280.mp3"
    },
    {
      "ru": "Ответная форма на приветствие «Ассалам Ӏалайкум» (буквально: «и вам мир»)",
      "ing": "Ва-Ӏалайкум салам",
      "pron": "va-ӏalaykum salam",
      "id": "paydadosh_pd_19930",
      "audio": "paydadosh_pd_19930.mp3"
    },
    {
      "ru": "Пожелание удачи в работе, если застали человека за работой (буквально: «счастье имея работа пусть будет»)",
      "ing": "Ираз долаш болх хилба",
      "pron": "iraz dolash bolkh khilba",
      "id": "paydadosh_pd_19964",
      "audio": "paydadosh_pd_19964.mp3"
    },
    {
      "ru": "Почитание гостя",
      "ing": "хьаьша ларх1ар",
      "pron": "khьaьsha larkh1ar",
      "id": "paydadosh_pd_1279",
      "audio": "paydadosh_pd_1279.mp3"
    },
    {
      "ru": "Прибытие гостя",
      "ing": "хьаьша хьавара",
      "pron": "khьaьsha khьavara",
      "id": "paydadosh_pd_1278",
      "audio": "paydadosh_pd_1278.mp3"
    },
    {
      "ru": "Прием гостя",
      "ing": "хьаьша тIаэцар",
      "pron": "khьaьsha tiaetsar",
      "id": "paydadosh_pd_1282",
      "audio": "paydadosh_pd_1282.mp3"
    },
    {
      "ru": "Приход гостя",
      "ing": "хьаьша вāр",
      "pron": "khьaьsha vār",
      "id": "paydadosh_pd_1277",
      "audio": "paydadosh_pd_1277.mp3"
    },
    {
      "ru": "Проводы гостя",
      "ing": "хьаьша накъаваккхар",
      "pron": "khьaьsha nakъavakkkhar",
      "id": "paydadosh_pd_1281",
      "audio": "paydadosh_pd_1281.mp3"
    },
    {
      "ru": "Пусть Аллах защитит тебя от плохого!",
      "ing": "Дала воча х1амах лораволва (лорайойла) хьо!",
      "pron": "dala vocha kh1amakh loravolva (lorayoyla) khьo!",
      "id": "paydadosh_pd_1287",
      "audio": "paydadosh_pd_1287.mp3"
    },
    {
      "ru": "Пусть Аллах примет ваш пост",
      "ing": "Аллахьу марх къоабал долда шун.",
      "pron": "allakhьu markh kъoabal dolda shun.",
      "id": "paydadosh_pd_2",
      "audio": "paydadosh_pd_2.mp3"
    },
    {
      "ru": "Пусть ваш пост будет принят",
      "ing": "Марха къоабала хилда шун! Хьийга хало малехь язйойла! Дехка а, даста а, ер ха, ер ди марша юхадоагІалда вайна!",
      "pron": "markha kъoabala khilda shun! khьiyga khalo malekhь yazyoyla! dekhka a, dasta a, er kha, er di marsha yukhadoagіalda vayna!",
      "id": "paydadosh_pd_5",
      "audio": "paydadosh_pd_5.mp3"
    },
    {
      "ru": "Пусть Всевышний запишет воздаяние за испытанные трудности!",
      "ing": "Хьийга хало Дала маьлехьа язйойла",
      "pron": "khьiyga khalo dala maьlekhьa yazyoyla",
      "id": "paydadosh_pd_686",
      "audio": "paydadosh_pd_686.mp3"
    },
    {
      "ru": "Пусть Всевышний примет ваше жертвоприношение!",
      "ing": "Да́ла къоабала долда шун гӀурба",
      "pron": "dála kъoabala dolda shun gӏurba",
      "id": "paydadosh_pd_683",
      "audio": "paydadosh_pd_683.mp3"
    },
    {
      "ru": "Пусть Всевышний примет от нас и от вас!",
      "ing": "Да́ла къоабалдаь дӀаэцалда тхогара а шугара а",
      "pron": "dála kъoabaldaь dӏaetsalda tkhogara a shugara a",
      "id": "paydadosh_pd_684",
      "audio": "paydadosh_pd_684.mp3"
    },
    {
      "ru": "Пусть Всевышний примет твоё (ваше) паломничество!",
      "ing": "Дала къоабала долда хьа (шун) хьажол",
      "pron": "dala kъoabala dolda khьa (shun) khьazhol",
      "id": "paydadosh_pd_674",
      "audio": "paydadosh_pd_674.mp3"
    },
    {
      "ru": "Пусть Всевышний примет твою (вашу) умру (малое паломничество)!",
      "ing": "Дала къоабала долда хьа (шун) Ӏумрат",
      "pron": "dala kъoabala dolda khьa (shun) ӏumrat",
      "id": "paydadosh_pd_675",
      "audio": "paydadosh_pd_675.mp3"
    },
    {
      "ru": "Пусть Всевышний простит его (её) / их!",
      "ing": "Да́ла гешт до́лда цунна/ца́рна!",
      "pron": "dála gesht dólda tsunna/tsárna!",
      "id": "paydadosh_pd_665",
      "audio": "paydadosh_pd_665.mp3"
    },
    {
      "ru": "Пусть Всевышний простит его/ее/их",
      "ing": "Да́ла гешт до́лда цунна/ца́рна! Да́ла къахе́там бо́лба цох/ца́рех! Да́ла иман сабр лулда шоана!",
      "pron": "dála gesht dólda tsunna/tsárna! dála kъakhétam bólba tsokh/tsárekh! dála iman sabr lulda shoana!",
      "id": "paydadosh_pd_355",
      "audio": "paydadosh_pd_355.mp3"
    },
    {
      "ru": "Пусть Всевышний смилостивится над ним (ней) / ними!",
      "ing": "Да́ла къахе́там бо́лба цох/ца́рех!",
      "pron": "dála kъakhétam bólba tsokh/tsárekh!",
      "id": "paydadosh_pd_664",
      "audio": "paydadosh_pd_664.mp3"
    },
    {
      "ru": "Пусть и тобой будет доволен Всевышний",
      "ing": "Хьона а хилва АллоахӀ раьза.",
      "pron": "khьona a khilva alloakhӏ raьza.",
      "id": "paydadosh_pd_1",
      "audio": "paydadosh_pd_1.mp3"
    },
    {
      "ru": "Пусть место его (её), куда ушёл он (ушла она), Всевышний сделает счастливым!",
      "ing": "Вийрза́ (Йийрза́) моттиг Да́ла да́ькъала йо́йла цун!",
      "pron": "viyrzá (yiyrzá) mottig dála dáьkъala yóyla tsun!",
      "id": "paydadosh_pd_666",
      "audio": "paydadosh_pd_666.mp3"
    },
    {
      "ru": "Пусть место её, куда ушла она, Всевышний сделает счастливым!",
      "ing": "Да́ла Ялсамален совгӀат лулда цунна!",
      "pron": "dála yalsamalen sovgӏat lulda tsunna!",
      "id": "paydadosh_pd_668",
      "audio": "paydadosh_pd_668.mp3"
    },
    {
      "ru": "Пусть место их, куда ушли они, Всевышний сделает счастливым!",
      "ing": "Бийрза́ моттиг Да́ла да́ькъала йо́йла цар!",
      "pron": "biyrzá mottig dála dáьkъala yóyla tsar!",
      "id": "paydadosh_pd_667",
      "audio": "paydadosh_pd_667.mp3"
    },
    {
      "ru": "Религиозная форма благодарности (буквально: «да будет (это) милостыней»)",
      "ing": "СагӀ хилда",
      "pron": "sagӏ khilda",
      "id": "paydadosh_pd_19950",
      "audio": "paydadosh_pd_19950.mp3"
    },
    {
      "ru": "Религиозная форма благодарности после доброго поступка или помощи",
      "ing": "АллахӀ раьза хилва хьона",
      "pron": "allakhӏ raьza khilva khьona",
      "id": "paydadosh_pd_19948",
      "audio": "paydadosh_pd_19948.mp3"
    },
    {
      "ru": "Религиозное благопожелание перед путешествием или в значимых ситуациях",
      "ing": "АллахӀо воча хӀамах лораволва хьо!",
      "pron": "allakhӏo vocha khӏamakh loravolva khьo!",
      "id": "paydadosh_pd_19946",
      "audio": "paydadosh_pd_19946.mp3"
    },
    {
      "ru": "Религиозное благопожелание удачи и успеха",
      "ing": "Далла аьттув боакхалба хьа!",
      "pron": "dalla aьttuv boakkhalba khьa!",
      "id": "paydadosh_pd_19960",
      "audio": "paydadosh_pd_19960.mp3"
    },
    {
      "ru": "Религиозное пожелание при долгом расставании (буквально: «если Аллах сказал/позволит, увидимся»)",
      "ing": "АллахӀо аьннадале бӀаргагургда вай!",
      "pron": "allakhӏo aьnnadale bӏargagurgda vay!",
      "id": "paydadosh_pd_19947",
      "audio": "paydadosh_pd_19947.mp3"
    },
    {
      "ru": "Религиозный ответ на приветствие нескольких людей",
      "ing": "Далла дезалда шо",
      "pron": "dalla dezalda sho",
      "id": "paydadosh_pd_19939",
      "audio": "paydadosh_pd_19939.mp3"
    },
    {
      "ru": "Религиозный ответ на приветствие, обращён к женщине",
      "ing": "Далла езийла хьо",
      "pron": "dalla eziyla khьo",
      "id": "paydadosh_pd_19938",
      "audio": "paydadosh_pd_19938.mp3"
    },
    {
      "ru": "Религиозный ответ на приветствие, обращён к мужчине",
      "ing": "Далла везийла хьо",
      "pron": "dalla veziyla khьo",
      "id": "paydadosh_pd_19937",
      "audio": "paydadosh_pd_19937.mp3"
    },
    {
      "ru": "Следить за языком; хранить молчание",
      "ing": "Мотт кхаба",
      "pron": "mott kkhaba",
      "id": "paydadosh_pd_1283",
      "audio": "paydadosh_pd_1283.mp3"
    },
    {
      "ru": "Устоявшаяся формула приветствия гостя хозяевам при входе в дом (буквально: «пусть всё хорошее придёт в этот дом»)",
      "ing": "Дика мелдар доагӀалда укх цӀагӀа",
      "pron": "dika meldar doagӏalda ukkh tsӏagӏa",
      "id": "paydadosh_pd_19963",
